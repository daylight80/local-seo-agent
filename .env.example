# Copy this file to .env and fill in what you have. Each command tells you when it needs one.
# .env is gitignored. Never commit it, never paste a key into a chat or onto a page.

# Apify - /gbp-post scrapes Reddit for what buyers actually ask about.
# Free tier is plenty: apify.com > Settings > Integrations > API token.
APIFY_TOKEN=

# Pexels - photos for /build-website, /service-page and /blog-post.
# Free, no card: pexels.com/api. Without it, pages fall back to Openverse.
PEXELS_API_KEY=

# Blotato - /blotato schedules the social posts. Paid only, so skip it if you are not using it.
# blotato.com > Settings > API.
BLOTATO_API_KEY=

# Where the contact and quote forms post. Any webhook URL works - Make, Zapier, GoHighLevel.
# Until this is set, the forms show an error instead of submitting.
LEAD_WEBHOOK_URL=

# /gbp-post publishes through Metricool (the Metricool connector in Claude), so it needs no key here.
# Only if you switch on the optional Make.com route for real Offer/Event posts:
# Make > new scenario > Webhooks > Custom webhook > copy the URL.
MAKE_WEBHOOK_URL=
